{
  "expo": {
    "name": "moov",
    "slug": "moov",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/image/bg/loading.png",
    "scheme": "moov",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.zoniix.moov",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f1f0ef",
        "foregroundImage": "./assets/image/bg/loading.png",
        "backgroundImage": "./assets/image/bg/loading.png",
        "monochromeImage": "./assets/image/bg/loading.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zoniix.moov"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/image/bg/loading.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f1f0ef",
          "image": "./assets/image/bg/loading.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07e8d75a-67b1-49df-834b-32b2fffeef24"
      }
    }
  }
}