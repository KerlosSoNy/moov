{
  "expo": {
    "name": "Moov",
    "slug": "moov",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/image/logos/3.png",
    "scheme": "moov",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/image/logos/3.png",
      "bundleIdentifier": "com.zoniix.moov",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f1f0ef",
        "foregroundImage": "./assets/image/logos/3.png",
        "backgroundImage": "./assets/image/logos/3.png",
        "monochromeImage": "./assets/image/logos/3.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zoniix.moov"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/image/logos/3.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f1f0ef",
          "image": "./assets/image/logos/3.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can set a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#e05252",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07e8d75a-67b1-49df-834b-32b2fffeef24"
      }
    }
  }
}