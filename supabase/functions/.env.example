# Edge Function secrets. Set them with:
#   npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# by the Edge runtime automatically; don't set them here.

# Shared secret that Supabase Cron sends as "Authorization: Bearer <secret>".
# At least 32 characters; must equal the Vault secret notifications_cron_secret.
# Generate one with: openssl rand -hex 32
CRON_SECRET=replace-with-64-hex-characters

# Optional: Expo access token, required only if "Enhanced security for push
# notifications" is enabled for the project on expo.dev
EXPO_ACCESS_TOKEN=
