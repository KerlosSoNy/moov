# Copy to .env. Everything prefixed EXPO_PUBLIC_ is bundled into the app and
# is public by design. Never put a service-role/secret key here.

# Trakt (international movies and series)
EXPO_PUBLIC_APP_URL=https://api.trakt.tv
EXPO_PUBLIC_CLIENT_ID=your-trakt-client-id

# Supabase: project URL and the publishable (anon) key only
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Shoof Aflam needs no key: https://shoofaflam.tv/api/titles.json

# TMDB: Arabic + English descriptions for Shoof Aflam titles (its API has none).
# Free key: https://www.themoviedb.org/settings/api — either the v3 "API Key"
# or the v4 "API Read Access Token" works. Read-only public data.
EXPO_PUBLIC_TMDB_API_KEY=your-tmdb-key
